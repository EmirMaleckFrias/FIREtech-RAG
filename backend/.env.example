# Copiar a backend/.env y rellenar
OPENAI_API_KEY=
# Endpoint del API. Vacio = api.openai.com. Para un endpoint compatible (AI
# Gateway de Vercel: https://ai-gateway.vercel.sh/v1, clave vck_...) los tres
# modelos de abajo llevan el proveedor por delante: openai/gpt-5.4, etc.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4
EMBEDDING_MODEL=text-embedding-3-large
# Reranker y filtro de relevancia. Vacio = hereda OPENAI_MODEL (unas 5 veces mas caro por token)
RERANK_MODEL=gpt-5.4-mini
# Cliente OpenAI unico: timeout por request (s), reintentos del SDK, llamadas concurrentes
OPENAI_TIMEOUT_S=120
OPENAI_MAX_RETRIES=2
OPENAI_CONCURRENCY=3
# Etiqueta del prompt del agente; viaja en /api/health, /api/stats, telemetria y evals
PROMPT_VERSION=v3
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documentos
# server = BM25 nativo de Qdrant (recomendado y compatible con Vercel);
# fastembed = backend local antiguo; auto = servidor y fallback local;
# disabled = dense-only. Cambiarlo exige reindexar todos los documentos.
QDRANT_BM25_BACKEND=server
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Busquedas por pregunta. 0 = sin limite; los frenos reales son los dos de abajo
MAX_HOPS=0
# Segundos de reloj antes de forzar la respuesta (la funcion de Vercel muere a los 300)
AGENT_BUDGET_S=240
# Busquedas seguidas sin encontrar nada nuevo antes de responder con lo que hay
AGENT_MAX_HOPS_SIN_AVANCE=3
# Plan de evidencia previo en modo extendido (1-8 búsquedas)
ENABLE_QUERY_PLANNING=true
PLANNER_MAX_QUERIES=5
# Mantiene el borrador privado hasta aprobar sus citas; ante fallo se abstiene.
ENABLE_ANSWER_VERIFICATION=true
ENABLE_PRE_RESPONSE_REVIEW=true
PRE_RESPONSE_REVIEW_MAX_REVISIONS=1
PRE_RESPONSE_REVIEW_TIMEOUT_S=45
RERANK_TOP_K=12
SEARCH_TOP_K=60
# 'local' o 'production': separa el registro de documentos por entorno
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173
