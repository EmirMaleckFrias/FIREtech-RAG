# Frontend (Vite). Copia este archivo a .env; solo las claves VITE_* llegan al
# navegador, asi que aqui NUNCA va una clave de servidor (las del gateway y las
# de Convex Auth viven en las variables del despliegue de Convex).
#
# La URL del despliegue es publica por diseno: quien protege los datos es el
# servidor, que comprueba quien pregunta en cada funcion (convex/permisos.ts).

VITE_CONVEX_URL=https://gregarious-pony-327.convex.cloud

# Solo para la CLI en local (npx convex dev / run / env): la clave de despliegue de
# Convex. Va en .env.local, que esta ignorado por git, NUNCA en este fichero ni en
# el repositorio (es publico). En Vercel se configura como variable del proyecto.
# CONVEX_DEPLOY_KEY=dev:<despliegue>|<clave>
